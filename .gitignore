# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Android release signing material must never be committed
*.jks
*.keystore
/android/key.properties
/build/symbols/

# Local environment configuration (real values). Examples are tracked.
config/*.json
!config/*.example.json

# Supabase local
supabase/.branches
supabase/.temp

# Firebase client config: per-project, downloaded from the Firebase console.
# Never commit it; builds without it run with push notifications disabled.
android/app/google-services.json
ios/Runner/GoogleService-Info.plist
